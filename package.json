{
  "name": "skillgraph",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "dev": "pnpm --filter @skillgraph/web dev",
    "build": "pnpm run build:graph && pnpm --filter @skillgraph/web build",
    "typecheck": "tsc --noEmit && pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @skillgraph/web test:e2e",
    "validate:skills": "tsx scripts/validate-skills.ts",
    "validate:stage": "tsx scripts/validate-stage-graph.ts",
    "validate": "pnpm run typecheck && pnpm run test && pnpm run validate:skills && pnpm run validate:stage",
    "build:index": "tsx scripts/build-index.ts",
    "build:graph": "tsx scripts/build-graph.ts",
    "residual-budget": "tsx scripts/residual-budget.ts",
    "check-distribution": "tsx scripts/check-distribution.ts",
    "pass2": "tsx scripts/generate-pass2.ts"
    ,"pass3": "tsx scripts/normalise-granularity.ts",
    "pass4": "tsx scripts/detect-duplicates.ts",
    "pass5": "tsx scripts/assign-ids.ts && tsx scripts/build-index.ts && tsx scripts/residual-budget.ts && tsx scripts/check-distribution.ts",
    "checkpoint:cp1": "tsx scripts/checkpoint-report.ts"
    ,"pass6": "tsx scripts/propose-edges.ts"
    ,"pass7": "tsx scripts/adjudicate-edges.ts"
    ,"pass8": "tsx scripts/assemble-groups.ts && tsx scripts/transitive-reduce.ts"
    ,"pass9": "tsx scripts/apply-alternative-routes.ts"
    ,"pass10": "tsx scripts/cross-domain-enrich.ts"
    ,"pass11": "tsx scripts/detect-cycles.ts && tsx scripts/validate-stage-graph.ts"
    ,"pass12": "tsx scripts/write-skill-text.ts && tsx scripts/build-index.ts && tsx scripts/residual-budget.ts && tsx scripts/build-final-embeddings.ts"
    ,"repair:structural": "tsx scripts/repair-structural-duplicates.ts && tsx scripts/build-final-embeddings.ts"
    ,"pass13": "tsx scripts/lint-safety-neutrality.ts && tsx scripts/build-index.ts && tsx scripts/build-final-embeddings.ts"
    ,"pass14": "tsx scripts/redteam.ts"
    ,"pass15": "python scripts/compute-layout.py --seed 42"
    ,"pass16": "tsx scripts/build-graph.ts"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "ajv": "8.20.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
