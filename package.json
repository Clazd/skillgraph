{
  "name": "skillgraph",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:skills": "tsx scripts/validate-skills.ts",
    "validate": "pnpm run typecheck && pnpm run test && pnpm run validate:skills",
    "build:index": "tsx scripts/build-index.ts",
    "residual-budget": "tsx scripts/residual-budget.ts",
    "check-distribution": "tsx scripts/check-distribution.ts",
    "pass2": "tsx scripts/generate-pass2.ts"
    ,"pass3": "tsx scripts/normalise-granularity.ts",
    "pass4": "tsx scripts/detect-duplicates.ts",
    "pass5": "tsx scripts/assign-ids.ts && tsx scripts/build-index.ts && tsx scripts/residual-budget.ts && tsx scripts/check-distribution.ts",
    "checkpoint:cp1": "tsx scripts/checkpoint-report.ts"
    ,"pass6": "tsx scripts/propose-edges.ts"
    ,"pass7": "tsx scripts/adjudicate-edges.ts"
    ,"pass8": "tsx scripts/assemble-groups.ts && tsx scripts/transitive-reduce.ts"
    ,"pass9": "tsx scripts/apply-alternative-routes.ts"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "ajv": "8.20.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
