{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillgraph.local/schemas/skill.schema.json",
  "title": "SkillGraph skill",
  "description": "Normative authoring schema for one line of a domain JSONL file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "name",
    "short_description",
    "description",
    "domain",
    "secondary_domains",
    "tags",
    "difficulty",
    "time_to_learn",
    "self_assessment",
    "unlock_rules",
    "builds_on",
    "examples",
    "safety_note",
    "status",
    "superseded_by"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+\\.[a-z0-9-]+\\.[a-z0-9-]+$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "short_description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=(?:\\s*\\S+){40,120}\\s*$)[\\s\\S]+$"
    },
    "domain": { "$ref": "#/$defs/domain" },
    "secondary_domains": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/domain" }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "difficulty": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "time_to_learn": {
      "enum": ["minutes", "hours", "days", "weeks", "months", "years"]
    },
    "self_assessment": {
      "type": "string",
      "allOf": [
        { "pattern": "^I can " },
        { "pattern": "^[^.!?]+[.!?]$" },
        { "pattern": "^(?=(?:\\s*\\S+){1,30}\\s*$)[\\s\\S]+$" },
        {
          "not": {
            "pattern": "\\b(?:[Gg][Oo][Oo][Dd]|[Cc][Oo][Mm][Ff][Oo][Rr][Tt][Aa][Bb][Ll][Ee]|[Uu][Nn][Dd][Ee][Rr][Ss][Tt][Aa][Nn][Dd]|[Kk][Nn][Oo][Ww]|[Ff][Aa][Mm][Ii][Ll][Ii][Aa][Rr]|[Cc][Oo][Nn][Ff][Ii][Dd][Ee][Nn][Tt]|[Ww][Ee][Ll][Ll]|[Pp][Rr][Oo][Pp][Ee][Rr][Ll][Yy]|[Ee][Ff][Ff][Ee][Cc][Tt][Ii][Vv][Ee][Ll][Yy]|[Gg][Ee][Nn][Ee][Rr][Aa][Ll][Ll][Yy]|[Uu][Ss][Uu][Aa][Ll][Ll][Yy]|[Bb][Aa][Ss][Ii][Cc])\\b"
          }
        },
        {
          "anyOf": [
            { "pattern": "\\b\\d+(?:[.,]\\d+)?\\b" },
            { "pattern": "\\b(?:one|two|three|four|five|six|seven|eight|nine|ten|once|twice)\\b" },
            { "pattern": "\\b(?:second|seconds|minute|minutes|hour|hours|day|days|week|weeks|month|months|year|years|metre|metres|kilometre|kilometres|percent|times|items|steps|conditions)\\b" },
            { "pattern": "\\b(?:when|while|until|within|at least|up to|without help)\\b" }
          ]
        },
        {
          "anyOf": [
            { "pattern": "\\bwithout\\b" },
            { "pattern": "\\bindependently\\b" },
            { "pattern": "\\bon my own\\b" },
            { "pattern": "\\bunaided\\b" }
          ]
        }
      ]
    },
    "unlock_rules": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/unlockGroup" }
    },
    "builds_on": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/softEdge" }
    },
    "examples": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "safety_note": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "status": { "enum": ["active", "deprecated"] },
    "superseded_by": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[a-z0-9]+\\.[a-z0-9-]+\\.[a-z0-9-]+$" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "deprecated" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "superseded_by": { "type": "string" } }
      },
      "else": {
        "properties": { "superseded_by": { "type": "null" } }
      }
    }
  ],
  "$defs": {
    "domain": {
      "enum": ["body", "care", "food", "home", "lang", "social", "reason", "learn", "digital", "eng", "art", "world"]
    },
    "skillId": {
      "type": "string",
      "pattern": "^[a-z0-9]+\\.[a-z0-9-]+\\.[a-z0-9-]+$"
    },
    "anyOfSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "of"],
      "properties": {
        "n": { "type": "integer", "minimum": 1, "maximum": 5 },
        "of": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/skillId" }
        }
      }
    },
    "unlockGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "all"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "all": {
          "type": "array",
          "minItems": 0,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/skillId" }
        },
        "any_of": { "$ref": "#/$defs/anyOfSet" }
      },
      "anyOf": [
        { "properties": { "all": { "type": "array", "minItems": 1 } } },
        {
          "required": ["any_of"],
          "properties": { "any_of": { "$ref": "#/$defs/anyOfSet" } }
        }
      ]
    },
    "softEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "strength", "note"],
      "properties": {
        "id": { "$ref": "#/$defs/skillId" },
        "strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "note": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    }
  }
}
